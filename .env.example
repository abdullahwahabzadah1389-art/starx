# StarX — environment (by Sm0ke)
#
# Wisp relay used by the libcurl transport.
# Comma-separated list is allowed; the loader probes each entry in order (it sends
# a real Wisp INFO packet and needs a 0x03 reply) and uses the first live relay.
#
# If unset, the loader falls back to this built-in order:
#   wss://anura.pro/
#   wss://wisp.terbiumon.top/wisp/
#   wss://wisp.mercurywork.shop/
#   wss://fern.best/wisp/
#   wss://lunaar.org/wisp/
#   wss://kristenblackburnvolleyballcamps.com/socket/
#
# There is no local /wisp/ endpoint: Vercel cannot host a persistent WebSocket.
#
# A self-hosted relay wins outright when set (it is never raced against the
# public list). See worker.js in the repo root for a ready-made Cloudflare
# Worker that speaks Wisp v1.
NEXT_PUBLIC_WISP_URL=wss://anura.pro/
